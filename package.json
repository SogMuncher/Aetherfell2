{
  "name": "aetherfell-2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node scripts/buildPlay.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "check:sim": "node scripts/check.mjs all --no-tsc",
    "build:vite": "vite build",
    "check:data": "node scripts/check.mjs dataSmoke --no-tsc",
    "check:boot": "vite build && node scripts/bootSmoke.mjs",
    "check": "node scripts/codemap.mjs && node scripts/check.mjs",
    "codemap": "node scripts/codemap.mjs --big"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "peerjs": "^1.5.5"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vite": "^7.3.8",
    "esbuild": "^0.28.2"
  }
}
